{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safdafang.github.io/goose-index/schema/index.schema.json",
  "title": "Goose Package Index: index.json",
  "description": "The whole index for tools. Generated by scripts/build.py; documented in docs/index-json.md. 'version' changes only when a change could break a reader; new fields can appear at any time, so readers must ignore fields they don't know.",
  "type": "object",
  "required": ["format", "version", "generated_at", "site", "source", "categories", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "goose-index" },
    "version": { "const": 1 },
    "generated_at": { "$ref": "#/$defs/time" },
    "meta_fetched_at": { "type": ["string", "null"] },
    "compat": {
      "type": ["object", "null"],
      "properties": {
        "goose": { "type": ["string", "null"], "description": "The Goose release the last build test used, e.g. v2026.3. A result made with another release says so in its own goose field." },
        "ran_at": { "type": ["string", "null"] },
        "run_url": { "type": ["string", "null"] }
      }
    },
    "site": { "type": "string" },
    "source": { "type": "string" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "scope", "count"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "scope": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$" },
    "os": { "enum": ["linux", "macos", "windows"] },
    "entry": {
      "type": "object",
      "required": ["id", "name", "kind", "category", "tags", "description", "repo", "url", "page", "available",
                   "archived", "license", "platforms", "native", "import", "compat", "requires"],
      "properties": {
        "id": { "type": "string", "description": "Stable key. Never reused for another project." },
        "name": { "type": "string" },
        "kind": { "enum": ["package", "binding", "tool", "editor", "app", "fork", "learning-resource"] },
        "category": { "type": "string", "description": "One of categories[].id." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "repo": { "type": ["string", "null"], "description": "The git repository (https, no .git), at its current address when it was renamed; null for an article." },
        "url": { "type": "string", "description": "Where a person should go: the repository, or the article." },
        "page": { "type": "string", "description": "The entry's page on the index site." },
        "available": { "type": "boolean", "description": "false when the repository has been deleted or made private, or when a different repository now answers at its address." },
        "archived": { "type": "boolean" },
        "latest_tag": { "type": ["string", "null"] },
        "tag_count": { "type": ["integer", "null"] },
        "default_branch": { "type": ["string", "null"] },
        "last_commit": { "type": ["string", "null"], "description": "Head commit of the default branch, ISO 8601." },
        "created": { "type": ["string", "null"] },
        "stars": { "type": ["integer", "null"] },
        "license": { "type": ["string", "null"], "description": "SPDX id, 'other' (a license GitHub can't name), 'none' (no license file), or null (not fetched)." },
        "license_source": { "enum": ["github", "entry", null] },
        "platforms": { "type": "array", "items": { "$ref": "#/$defs/os" }, "description": "What the author claims. Empty means unstated." },
        "native": {
          "type": "object",
          "required": ["c", "cmake", "system_libs", "tools"],
          "properties": {
            "c": { "type": "boolean" }, "cmake": { "type": "boolean" },
            "system_libs": {
              "type": "object",
              "properties": {
                "linux": { "type": "array", "items": { "type": "string" }, "description": "apt package names" },
                "macos": { "type": "array", "items": { "type": "string" }, "description": "Homebrew formulae" },
                "windows": { "type": "array", "items": { "type": "string" } }
              }
            },
            "tools": { "type": "array", "items": { "type": "string" } }
          }
        },
        "upstream_fork": { "type": ["string", "null"] },
        "import": {
          "description": "For package and binding entries; null otherwise.",
          "type": ["object", "null"],
          "required": ["name", "source", "ref", "pinned", "commit", "line", "modules", "subdir"],
          "properties": {
            "name": { "type": "string" },
            "source": { "type": "string", "description": "What goes before @ in the import string, e.g. github.com/kaitk/goose-http." },
            "ref": { "type": "string", "description": "The latest tag, or the default branch when there is no tag." },
            "pinned": { "type": "boolean", "description": "true when ref is a tag." },
            "commit": { "type": ["string", "null"], "description": "The commit ref named when the index last looked, for tools that lock or verify what they fetch; null when ref is a branch or the commit is not known yet." },
            "line": { "type": ["string", "null"], "description": "The import line to paste; null when the package lives in a subdirectory Goose can't import by URL, or when the repository is unavailable." },
            "modules": { "type": "array", "items": { "type": "string" } },
            "subdir": { "type": ["string", "null"] }
          }
        },
        "compat": {
          "description": "Build-test results per OS; null when never tested.",
          "type": ["object", "null"],
          "propertyNames": { "$ref": "#/$defs/os" },
          "additionalProperties": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "enum": ["pass", "check", "fail", "skip"] },
              "ref": { "type": "string" },
              "stage": { "type": "string" },
              "detail": { "type": "string", "description": "The first error line, for fail and check." },
              "reason": { "type": "string", "description": "Why it was not built, for skip." },
              "entry": { "type": "string" },
              "goose": { "type": "string", "description": "The Goose release this result was made with. Absent on results older than the field." },
              "ran_at": { "$ref": "#/$defs/time", "description": "When this result was made." }
            }
          }
        },
        "requires": {
          "description": "Packages the build test had to declare for this one to compile, as the compiler asked for them.",
          "type": "array",
          "items": { "type": "object", "required": ["name", "source"],
                     "properties": { "name": { "type": "string" }, "source": { "type": "string" } } }
        }
      }
    }
  }
}
